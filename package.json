{
  "name": "openclaude",
  "version": "0.1.0",
  "description": "Your own personal AI assistant powered by Claude. Any OS. Any Platform. The Claude way. 🧠",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -b",
    "start": "node dist/cli/index.js",
    "gateway": "tsx src/gateway/server.ts",
    "dashboard": "cd ui/dashboard && npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "doctor": "tsx src/cli/commands/doctor.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "croner": "^9.0.0",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.35.0",
    "marked": "^15.0.7",
    "puppeteer": "^24.4.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
